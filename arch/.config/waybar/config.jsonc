{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],

  // ── Left ──────────────────────────────────────────
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  // ── Center ────────────────────────────────────────
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y年%m月%d日 %H:%M:%S}",
    "tooltip-format": "{calendar}",
    "on-click": "toggle-alt-format"
  },

  // ── Right ─────────────────────────────────────────
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "spacing": 8
  }
}
