{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Bash(mise use:*)",
      "Bash(nvim:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(nix --version)",
      "Bash(scutil --get ComputerName)",
      "Bash(scutil --get LocalHostName)",
      "Bash(curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix)",
      "Bash(sh -s -- install --no-confirm)",
      "Bash(darwin-rebuild --version)",
      "Read(//nix/store/sv4y5y7axb89vp29dbbk94rnisw8aal9-darwin-rebuild/bin/**)",
      "Bash(defaults read *)",
      "Bash(defaults write *)",
      "Bash(brew search *)",
      "Bash(brew info *)",
      "Bash(paclear --help)",
      "Bash(~/.local/share/mise/shims/paclear --help)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "markitdown"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"処理が完了しました\" with title \"Claude Code\"' && afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '(rm -rf|git push -f|--force)'; then afplay /System/Library/Sounds/Basso.aiff; fi"
          }
        ]
      }
    ]
  }
}
